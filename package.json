{
  "name": "lgtc-summit-estate-page",
  "version": "1.0.0",
  "private": true,
  "description": "Summit Estate page hosted by LGTC Group: a standalone Next.js static export for hand-over.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:staging": "export NEXT_PUBLIC_BASE_PATH=/lgtc-summit-microsite NEXT_PUBLIC_ROBOTS='noindex, nofollow'; next build && node scripts/prepare-staging.mjs",
    "typecheck": "tsc --noEmit",
    "test:a11y": "node scripts/a11y-check.mjs",
    "preview:staging": "npm run build:staging && wrangler dev",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "test:a11y:staging": "NEXT_PUBLIC_BASE_PATH=/lgtc-summit-microsite node scripts/a11y-check.mjs",
    "check:contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "playwright": "1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.3",
    "wrangler": "4.157.0"
  }
}
